# Токен бота від @BotFather
BOT_TOKEN=

# Telegram ID глобального адміністратора (дізнатися: @userinfobot)
ADMIN_ID=

# Шлях до бази даних (у Docker — /app/data/santa.db)
DB_PATH=./data/santa.db

# Необов'язково: URL чека healthchecks.io для моніторингу живості
HEALTHCHECK_URL=

# Рівень логування: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
